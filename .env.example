# ============================================================
# 复制本文件为 .env 并填入真实 key（.env 已被 .gitignore 排除）
# ============================================================

# 同济 AGI 网关（OpenAI 兼容协议）
LLM_API_KEY=sk-你的key
LLM_BASE_URL=https://agi.tongji.edu.cn/v1

# 对话模型：Flash 便宜，用于 NPC 大量日常对话
LLM_CHAT_MODEL=GLM-5.3-Flash
# 深度任务模型：反思、重要性与情感评定等关键调用
LLM_THINK_MODEL=GLM-5.3

# 记忆语义检索的向量模型
LLM_EMBED_MODEL=Qwen3-Embedding

# 注意：网关上的 GLM 是"推理模型"（先思考再回答），
# max_tokens 太小会导致正文 content 为 null，务必给足
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.8
